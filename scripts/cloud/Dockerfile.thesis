FROM debian:13-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    fonts-noto-cjk fonts-liberation fonts-arphic-uming fontconfig libreoffice-writer \
    poppler-utils python3-uno python3-pil ca-certificates \
    && rm -rf /var/lib/apt/lists/*
