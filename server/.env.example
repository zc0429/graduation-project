# 复制为 .env 并填入真实值；.env 已加入 .gitignore，禁止提交
DB_URL=jdbc:mysql://127.0.0.1:3306/wrongbook?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&useUnicode=true&allowPublicKeyRetrieval=true
DB_USERNAME=wrongbook
DB_PASSWORD=your-db-password
JWT_SECRET=replace-with-at-least-32-random-characters

# 非公网测试部署（仅在显式激活 deploy-test profile 时使用）
# DEPLOY_TEST_DB_URL=jdbc:mysql://127.0.0.1:3308/wrongbook_deploy_test?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&useUnicode=true&allowPublicKeyRetrieval=true
# DEPLOY_TEST_DB_USERNAME=wrongbook_deploy_runner
# DEPLOY_TEST_DB_PASSWORD=replace-with-random-test-database-password
# DEPLOY_TEST_JWT_SECRET=replace-with-at-least-32-random-characters
# DEPLOY_TEST_UPLOAD_DIR=D:/path/to/persistent-test-uploads
# DEPLOY_TEST_CORS_ORIGINS=http://127.0.0.1:4175
# DEPLOY_TEST_PORT=8081

# 正常运行默认真实 GLM；密钥不入库。离线需显式 LLM_PROVIDER=mock。
LLM_PROVIDER=glm
# 仅在人工加载到 Maven 进程环境并改为 true 时运行真实联网测试
RUN_LIVE_LLM_TESTS=false

# 智谱 GLM（正式目标；未设置的 URL/模型使用下列默认值）
# LLM_PROVIDER=glm
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=replace-with-your-glm-api-key
# LLM_CHAT_MODEL=glm-5.3-flash
# LLM_EMBEDDING_MODEL=embedding-3
# LLM_EMBEDDING_DIMENSIONS=1024
# LLM_CONNECT_TIMEOUT=10s
# LLM_READ_TIMEOUT=90s

# 图片错题识别（独立旁路，默认开启；可复用 LLM_API_KEY）
IMAGE_RECOGNITION_ENABLED=true
# IMAGE_RECOGNITION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# IMAGE_RECOGNITION_API_KEY=replace-with-your-glm-api-key
# IMAGE_RECOGNITION_MODEL=glm-5.3-flash
# IMAGE_RECOGNITION_MAX_BYTES=5242880
# 真实图片识别测试默认跳过，仅显式设为 true 时联网
RUN_LIVE_IMAGE_RECOGNITION_TESTS=false

# DeepSeek（仅提供聊天；Embedding 固定降级为本地 256 维字符 n-gram 哈希向量）
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=replace-with-your-deepseek-api-key
# LLM_CHAT_MODEL=deepseek-v4-flash

# 离线开发：同时设置 LLM_PROVIDER=mock 和 IMAGE_RECOGNITION_ENABLED=false。
# Maven test 固定 test profile；真实联网入口还需单独的 RUN_LIVE_* 开关。
